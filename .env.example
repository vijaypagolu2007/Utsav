# ---------- Gemini (server-only; never prefix with NEXT_PUBLIC_) ----------
# Key from https://aistudio.google.com/apikey. Without it the app runs in deterministic Demo Mode.
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.5-flash-lite)
GEMINI_MODEL=
# Optional: comma-separated models to try when the primary is busy (503/429), e.g. gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=
# Optional: MINIMAL | LOW | MEDIUM | HIGH | default (default LOW: faster replies inside the chat timeout)
GEMINI_THINKING_LEVEL=
# Optional: per-call Gemini timeout in ms (chat default 30000, max 45000; scan default 40000, max 55000)
GEMINI_TIMEOUT_MS=

# ---------- Shared guest links (server-only) ----------
# Production: Upstash Redis REST credentials (Vercel Marketplace → Upstash also sets KV_REST_API_URL / KV_REST_API_TOKEN,
# which are accepted too). Without them, /api/events returns 503 in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local development only: "file" stores shared events as JSON under UTSAV_DATA_DIR (default .data/).
# This is the default when NODE_ENV is not production (npm run dev). It is refused on Vercel.
# To try guest links with a local production build (npm run build && npm start), set UTSAV_STORE=file here:
# Next loads .env.local for next start too, so this also works on Windows, where VAR=value npm start doesn't.
UTSAV_STORE=
UTSAV_DATA_DIR=

# ---------- Optional Google sign-in + cloud save (Firebase) ----------
# Leave all of these empty to run without sign-in: the Sign in button is hidden, no Firebase code loads and
# /api/cloud/* answers 503. Firebase web app config (Project settings → Your apps → Web app): public identifiers,
# still env-only. Keyless: these four are the whole setup. No service account and no server secret; the server
# verifies ID tokens with Google's public keys and calls Firestore with the user's own token (firestore.rules apply).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
