{
  "name": "event-planner-copilot",
  "version": "1.0.0",
  "description": "GenAI event planning assistant with a live reactive canvas (wedding, birthday, community) on a deterministic reducer core",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"src/tests/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=80 src/tests/*.test.ts",
    "verify": "npm run demo:check && npm test && npm run test:coverage && npm run typecheck && npm run lint && npm run build",
    "demo:check": "tsx src/demo.ts | diff src/tests/demo.baseline.txt - && echo 'demo output unchanged'",
    "smoke:gemini": "tsx scripts/gemini-smoke.ts",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.30.0",
    "firebase": "^12.19.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "overrides": {
    "@firebase/app": "0.16.4"
  }
}
